# Redis Configuration
REDIS_HOST=localhost           # Replace with your Redis host
REDIS_PORT=6379                # Replace with your Redis port
REDIS_DB=0                     # Replace with your Redis database number

# Chat Session Configuration
CHAT_SESSION_TTL=24:00:00      # Time To Live (TTL) for chat sessions in HH:MM:SS format

# OpenAI Configuration List
OAI_CONFIG_LIST=[{"model":"<model_name>","api_type":"<api_type>","api_key":"<api_key>","base_url":"<base_url>","api_version":"<api_version>"}]
